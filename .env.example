# Copy this to .env and fill in your values
SECRET_KEY=change-this-to-a-random-secret-key
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENPHONE_API_KEY=your-openphone-api-key-here
OPENPHONE_SIGNING_SECRET=your-openphone-signing-secret-here

# Database — leave blank to use SQLite locally
# On Railway this is set automatically when you add the PostgreSQL addon
DATABASE_URL=

# TikTok LIVE overlay
LIVE_OVERLAY_TOKEN=generate-a-long-random-value
LIVE_DAILY_GOAL=500

# Imperial Local Node (shop-workstation AI drafts). OFF unless explicitly enabled
# after the additive migration migrations/20261111_local_ai_node.sql is approved.
LOCAL_NODE_ENABLED=false
# 48+ random characters; give the same value to the workstation installer only.
# Separate from INTERNAL_API_KEY. Rotate by changing it here and re-running install.ps1.
LOCAL_NODE_WORKER_KEY=
LOCAL_NODE_MODEL=imperial-diagnostics:latest
